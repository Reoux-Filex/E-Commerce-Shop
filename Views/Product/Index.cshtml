@model IEnumerable<E_Commerce_Shop.Models.Product>
@{
    ViewData["Title"] = "Products";
    var searchName  = ViewBag.SearchName as string;
    var sortBy      = ViewBag.SortBy as string ?? "Name";
    var sortOrder   = ViewBag.SortOrder as string ?? "asc";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages ?? 1);
    var nextOrder   = sortOrder == "asc" ? "desc" : "asc";
}

@section Styles {
<style>
    .page-header {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        padding: 3rem 0;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .page-header::before {
        content: "";
        position: absolute;
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(99,102,241,0.25), transparent);
        top: -100px; right: -100px;
        border-radius: 50%;
    }
    .page-header h1 {
        color: white;
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.5px;
        position: relative;
        z-index: 1;
    }
    .page-header p {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        position: relative;
        z-index: 1;
    }

    /* SEARCH BAR */
    .search-bar-wrapper {
        background: white;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
    }
    .search-input {
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.65rem 1rem 0.65rem 2.75rem;
        font-size: 0.9rem;
        width: 100%;
        transition: all 0.2s;
        background: #f9fafb;
    }
    .search-input:focus {
        outline: none;
        border-color: #6366f1;
        background: white;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
    }
    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 1rem;
    }
    .btn-search {
        background: #6366f1;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
    }
    .btn-search:hover {
        background: #4f46e5;
        color: white;
        transform: translateY(-1px);
    }
    .btn-clear {
        background: #f3f4f6;
        color: #6b7280;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-clear:hover {
        background: #e5e7eb;
        color: #374151;
    }
    .btn-add-product {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(99,102,241,0.3);
    }
    .btn-add-product:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(99,102,241,0.4);
        color: white;
    }

    /* SORT PILLS */
    .sort-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        border: 1.5px solid #e5e7eb;
        color: #6b7280;
        background: white;
    }
    .sort-pill:hover {
        border-color: #6366f1;
        color: #6366f1;
    }
    .sort-pill.active {
        background: #6366f1;
        color: white;
        border-color: #6366f1;
    }

    /* PRODUCT CARD */
    .product-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #f0f0f0;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
    }
    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 50px rgba(99,102,241,0.12);
        border-color: #e0e7ff;
    }
    .product-img-area {
        height: 200px;
        background: linear-gradient(135deg, #f5f3ff, #eef2ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        position: relative;
        overflow: hidden;
    }
    .product-img-area img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product-category-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255,255,255,0.95);
        color: #6366f1;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
        backdrop-filter: blur(10px);
    }
    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
    }
    .stock-ok   { background: #d1fae5; color: #059669; }
    .stock-low  { background: #fef3c7; color: #d97706; }
    .stock-out  { background: #fee2e2; color: #dc2626; }

    .product-body { padding: 1.25rem; }
    .product-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .product-desc {
        font-size: 0.8rem;
        color: #9ca3af;
        margin-bottom: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .product-price {
        font-size: 1.1rem;
        font-weight: 800;
        color: #6366f1;
    }
    .product-footer {
        padding: 0 1.25rem 1.25rem;
        display: flex;
        gap: 8px;
    }
    .btn-details {
        flex: 1;
        background: #f5f3ff;
        color: #6366f1;
        border: none;
        border-radius: 10px;
        padding: 0.55rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s;
    }
    .btn-details:hover {
        background: #ede9fe;
        color: #4f46e5;
    }
    .btn-cart {
        flex: 1;
        background: #6366f1;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.55rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s;
    }
    .btn-cart:hover {
        background: #4f46e5;
        color: white;
        transform: scale(1.02);
    }
    .btn-edit {
        background: #fef3c7;
        color: #d97706;
        border: none;
        border-radius: 10px;
        padding: 0.55rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-edit:hover { background: #fde68a; color: #b45309; }
    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
        border: none;
        border-radius: 10px;
        padding: 0.55rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-delete:hover { background: #fecaca; color: #b91c1c; }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        background: white;
        border-radius: 20px;
        border: 2px dashed #e5e7eb;
    }
    .empty-icon { font-size: 4rem; margin-bottom: 1rem; }

    /* PAGINATION */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin-top: 2.5rem;
    }
    .page-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        border: 1.5px solid #e5e7eb;
        color: #6b7280;
        background: white;
        transition: all 0.2s;
    }
    .page-btn:hover {
        border-color: #6366f1;
        color: #6366f1;
    }
    .page-btn.active {
        background: #6366f1;
        color: white;
        border-color: #6366f1;
    }
    .page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
    }
</style>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-grid-fill me-2"></i>All Products</h1>
        <p>
            Showing <strong style="color:white;">@ViewBag.TotalRecords</strong>
            products available
        </p>
    </div>
</div>

<div class="container pb-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert d-flex align-items-center gap-2 mb-4"
             style="background:#d1fae5; color:#065f46; border:none;
                    border-radius:12px; font-weight:500;">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <!-- SEARCH + FILTER BAR -->
    <div class="search-bar-wrapper">
        <form asp-action="Index" method="get">
            <input type="hidden" name="sortBy"    value="@sortBy" />
            <input type="hidden" name="sortOrder" value="@sortOrder" />
            <div class="row g-2 align-items-center">

                <!-- Search input -->
                <div class="col-md-5">
                    <div class="position-relative">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text"
                               name="searchName"
                               value="@searchName"
                               class="search-input"
                               placeholder="Search products by name..." />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn-search">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn-clear">
                        <i class="bi bi-x me-1"></i>Clear
                    </a>
                </div>

                <!-- Add Product (Admin only) -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-3 text-end">
                        <a asp-action="Create" class="btn-add-product">
                            <i class="bi bi-plus-lg"></i>Add Product
                        </a>
                    </div>
                }
            </div>
        </form>

        <!-- Sort Pills -->
        <div class="mt-3 d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted" style="font-size:0.8rem; font-weight:600;">
                Sort:
            </span>
            <a asp-action="Index"
               asp-route-searchName="@searchName"
               asp-route-sortBy="Name"
               asp-route-sortOrder="@(sortBy=="Name" ? nextOrder : "asc")"
               asp-route-page="1"
               class="sort-pill @(sortBy=="Name" ? "active" : "")">
                <i class="bi bi-sort-alpha-down"></i>
                Name @(sortBy=="Name" ? (sortOrder=="asc" ? "↑" : "↓") : "")
            </a>
            <a asp-action="Index"
               asp-route-searchName="@searchName"
               asp-route-sortBy="Price"
               asp-route-sortOrder="@(sortBy=="Price" ? nextOrder : "asc")"
               asp-route-page="1"
               class="sort-pill @(sortBy=="Price" ? "active" : "")">
                <i class="bi bi-currency-dollar"></i>
                Price @(sortBy=="Price" ? (sortOrder=="asc" ? "↑" : "↓") : "")
            </a>
        </div>
    </div>

    <!-- PRODUCT GRID -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <h4 class="fw-bold text-dark">No products found</h4>
            <p class="text-muted">Try a different search term</p>
            <a asp-action="Index" class="btn-add-product mt-3"
               style="display:inline-flex;">
                Show All Products
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var p in Model)
            {
                <div class="col">
                    <div class="product-card">
                        <!-- Image Area -->
                        <div class="product-img-area">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="~/images/@p.ImageUrl" alt="@p.Name" />
                            }
                            else
                            {
                                <span>📦</span>
                            }
                            <!-- Category badge -->
                            <span class="product-category-badge">
                                @p.Category?.Name
                            </span>
                            <!-- Stock badge -->
                            @if (p.Stock == 0)
                            {
                                <span class="stock-badge stock-out">Out of Stock</span>
                            }
                            else if (p.Stock <= 5)
                            {
                                <span class="stock-badge stock-low">
                                    Only @p.Stock left
                                </span>
                            }
                            else
                            {
                                <span class="stock-badge stock-ok">In Stock</span>
                            }
                        </div>

                        <!-- Body -->
                        <div class="product-body">
                            <div class="product-name">@p.Name</div>
                            <div class="product-desc">@p.Description</div>
                            <div class="product-price">
                                @p.Price.ToString("N0")đ
                            </div>
                        </div>

                        <!-- Footer Buttons -->
                        <div class="product-footer">
                            <a asp-action="Details"
                               asp-route-id="@p.ProductId"
                               class="btn-details">
                                <i class="bi bi-eye me-1"></i>View
                            </a>

                            @if (User.Identity!.IsAuthenticated &&
                                 !User.IsInRole("Admin") &&
                                 p.Stock > 0)
                            {
                                <a asp-controller="Cart"
                                   asp-action="AddToCart"
                                   asp-route-productId="@p.ProductId"
                                   class="btn-cart">
                                    <i class="bi bi-cart-plus me-1"></i>Cart
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@p.ProductId"
                                   class="btn-edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@p.ProductId"
                                   class="btn-delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <div class="pagination-wrapper">
                <!-- Prev -->
                <a asp-action="Index"
                   asp-route-searchName="@searchName"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   asp-route-page="@(currentPage - 1)"
                   class="page-btn @(currentPage == 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left"></i>
                </a>

                <!-- Page numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-searchName="@searchName"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       asp-route-page="@i"
                       class="page-btn @(i == currentPage ? "active" : "")">
                        @i
                    </a>
                }

                <!-- Next -->
                <a asp-action="Index"
                   asp-route-searchName="@searchName"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   asp-route-page="@(currentPage + 1)"
                   class="page-btn @(currentPage == totalPages ? "disabled" : "")">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

            <p class="text-center text-muted mt-2" style="font-size:0.8rem;">
                Page @currentPage of @totalPages
                · @ViewBag.TotalRecords total products
            </p>
        }
    }
</div>