@model IEnumerable<E_Commerce_Shop.Models.Product>
@{
    ViewData["Title"] = "Products";
    var searchName = ViewBag.SearchName as string;
    var sortBy = ViewBag.SortBy as string ?? "Name";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var nextOrder = sortOrder == "asc" ? "desc" : "asc";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🛍️ Our Products</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">+ Add Product</a>
        }
    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <input type="hidden" name="sortBy" value="@sortBy" />
        <input type="hidden" name="sortOrder" value="@sortOrder" />
        <div class="col-md-6">
            <input type="text" name="searchName" value="@searchName"
                   class="form-control" placeholder="Search products..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">🔍 Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <!-- Sort buttons -->
    <div class="mb-3">
        <span class="me-2">Sort by:</span>
        <a asp-action="Index"
               asp-route-searchName="@searchName"
               asp-route-sortBy="Name"
               asp-route-sortOrder="@(sortBy == "Name" ? nextOrder : "asc")"
               asp-route-page="1"
               class="btn btn-sm @(sortBy == "Name" ? "btn-dark" : "btn-outline-dark")">
            Name @(sortBy == "Name" ? (sortOrder == "asc" ? "▲" : "▼") : "")
        </a>
        <a asp-action="Index"
               asp-route-searchName="@searchName"
               asp-route-sortBy="Price"
               asp-route-sortOrder="@(sortBy == "Price" ? nextOrder : "asc")"
               asp-route-page="1"
               class="btn btn-sm @(sortBy == "Price" ? "btn-dark" : "btn-outline-dark")">
            Price @(sortBy == "Price" ? (sortOrder == "asc" ? "▲" : "▼") : "")
        </a>
    </div>

    <!-- Product Cards Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="~/images/@p.ImageUrl"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;"
                             alt="@p.Name" />
                    }
                    else
                    {
                        <div class="bg-secondary d-flex align-items-center
                            justify-content-center"
                             style="height:200px;">
                            <span class="text-white fs-1">📦</span>
                        </div>
                    }
                    <div class="card-body">
                        <span class="badge bg-primary mb-1">@p.Category?.Name</span>
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted small">@p.Description</p>
                        <p class="fw-bold text-danger fs-5">
                            @p.Price.ToString("N0") VNĐ
                        </p>
                        <p class="text-muted small">
                            Stock: @p.Stock items
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@p.ProductId"
                           class="btn btn-sm btn-info flex-fill">Details</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@p.ProductId"
                               class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@p.ProductId"
                               class="btn btn-sm btn-danger">Delete</a>
                        }
                        @if (User.Identity!.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <a asp-controller="Cart" asp-action="AddToCart"
                                   asp-route-productId="@p.ProductId"
                                   class="btn btn-sm btn-success flex-fill">
                                🛒 Add to Cart
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <h4 class="text-muted">No products found 😢</h4>
                <a asp-action="Index" class="btn btn-primary mt-2">Show All</a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchName="@searchName"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       asp-route-page="@(currentPage - 1)">← Prev</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-searchName="@searchName"
                           asp-route-sortBy="@sortBy"
                           asp-route-sortOrder="@sortOrder"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchName="@searchName"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       asp-route-page="@(currentPage + 1)">Next →</a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted">
            Page @currentPage of @totalPages
            (@ViewBag.TotalRecords total products)
        </p>
    }
</div>