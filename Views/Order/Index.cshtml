@model IEnumerable<E_Commerce_Shop.Models.Order>
@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-4">
    <h2>📋 All Orders (Admin)</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Update Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.OrderId</td>
                    <td>@order.UserId</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@order.OrderItems.Count items</td>
                    <td class="fw-bold text-danger">
                        @order.TotalAmount.ToString("N0") VNĐ
                    </td>
                    <td>
                        @{
                            var badgeColor = order.Status switch
                            {
                                "Pending" => "warning",
                                "Processing" => "info",
                                "Shipped" => "primary",
                                "Delivered" => "success",
                                "Cancelled" => "danger",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@badgeColor">@order.Status</span>
                    </td>
                    <td>
                        <!-- Admin can change order status -->
                        <div class="d-flex gap-1 flex-wrap">
                            <a asp-action="UpdateStatus"
                               asp-route-orderId="@order.OrderId"
                               asp-route-status="Processing"
                               class="btn btn-xs btn-info btn-sm">Processing</a>
                            <a asp-action="UpdateStatus"
                               asp-route-orderId="@order.OrderId"
                               asp-route-status="Shipped"
                               class="btn btn-xs btn-primary btn-sm">Shipped</a>
                            <a asp-action="UpdateStatus"
                               asp-route-orderId="@order.OrderId"
                               asp-route-status="Delivered"
                               class="btn btn-xs btn-success btn-sm">Delivered</a>
                            <a asp-action="UpdateStatus"
                               asp-route-orderId="@order.OrderId"
                               asp-route-status="Cancelled"
                               class="btn btn-xs btn-danger btn-sm">Cancel</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>