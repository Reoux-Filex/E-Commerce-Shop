<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        /* ===== NAVBAR ===== */
        .navbar {
            background: white !important;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            padding: 0.75rem 2rem;
        }
        .navbar-brand {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1a1a1a !important;
            letter-spacing: -0.5px;
        }
        .navbar-brand span {
            color: #6366f1;
        }
        .nav-link {
            color: #555 !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-link:hover {
            color: #6366f1 !important;
            background: #f0f0ff;
        }
        .btn-login-nav {
            background: #6366f1;
            color: white !important;
            border-radius: 10px;
            padding: 0.45rem 1.2rem !important;
            font-weight: 600;
        }
        .btn-login-nav:hover {
            background: #4f46e5;
            color: white !important;
        }
        /* Avatar circle */
        .avatar-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 13px;
        }
        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            border-radius: 14px;
            padding: 0.5rem;
            min-width: 220px;
        }
        .dropdown-item {
            border-radius: 8px;
            padding: 0.6rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .dropdown-item:hover { background: #f5f5ff; }

        /* ===== GLOBAL ===== */
        body {
            background: #f8f8ff;
            font-family: 'Segoe UI', sans-serif;
        }
        .page-content { min-height: calc(100vh - 130px); }

        /* ===== FOOTER ===== */
        footer {
            background: white;
            border-top: 1px solid #f0f0f0;
            padding: 1.5rem 0;
            text-align: center;
            color: #aaa;
            font-size: 0.85rem;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <!-- Logo -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            🛒 Shop<span>.</span>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <!-- Left nav -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-grid me-1"></i>Products
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Category" asp-action="Index">
                            <i class="bi bi-tags me-1"></i>Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Order" asp-action="Index">
                            <i class="bi bi-list-check me-1"></i>All Orders
                        </a>
                    </li>
                }
                @if (User.Identity!.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3 me-1"></i>My Cart
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Order" asp-action="MyOrders">
                            <i class="bi bi-bag me-1"></i>My Orders
                        </a>
                    </li>
                }
            </ul>

            <!-- Right nav -->
            <ul class="navbar-nav align-items-center gap-2">
                @if (User.Identity!.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-0"
                           href="#" role="button" data-bs-toggle="dropdown">
                            <div class="avatar-circle">
                                @User.Identity.Name!.Substring(0,1).ToUpper()
                            </div>
                            <span class="d-none d-md-inline fw-600 text-dark" style="font-size:0.875rem">
                                @User.Identity.Name!.Split('@')[0]
                            </span>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge rounded-pill"
                                      style="background:#fee2e2;color:#dc2626;font-size:0.7rem">
                                    Admin
                                </span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <div class="fw-bold text-dark" style="font-size:0.875rem">
                                        @User.Identity.Name!.Split('@')[0]
                                    </div>
                                    <div class="text-muted" style="font-size:0.75rem">
                                        @User.Identity.Name
                                    </div>
                                </div>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags me-2 text-primary"></i>Categories
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Order" asp-action="Index">
                                        <i class="bi bi-list-check me-2 text-success"></i>All Orders
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                        <i class="bi bi-bag me-2 text-warning"></i>My Orders
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link btn-login-nav"
                           asp-controller="Account" asp-action="Login">
                            <i class="bi bi-person me-1"></i>Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- PAGE CONTENT -->
<div class="page-content">
    @RenderBody()
</div>

<!-- FOOTER -->
<footer>
    <div class="container">
        <p class="mb-0">© 2025 E-Commerce Shop · Built with ASP.NET Core</p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>